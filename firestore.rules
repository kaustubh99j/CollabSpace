rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rule: Authenticated users can view workspace directory, but each user only edits their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Room / Channel rules: Strict User-Specific Access Control
    match /rooms/{roomId} {
      // Each user can ONLY read channels where they are an explicit member
      allow read: if request.auth != null && 
        resource.data.members != null && 
        request.auth.uid in resource.data.members;

      // When creating a channel, creator must be current authenticated user and must be in members
      allow create: if request.auth != null && 
        request.resource.data.createdBy == request.auth.uid && 
        request.auth.uid in request.resource.data.members;

      // Only existing members can update the channel (e.g. inviting new members or editing channel details)
      // Non-members CANNOT update or self-join
      allow update: if request.auth != null && 
        resource.data.members != null && 
        request.auth.uid in resource.data.members;

      // Only the channel creator can delete the channel
      allow delete: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;

      // Subcollection messages rules: Scoped to channel members only
      match /messages/{messageId} {
        // Only members of this room can read messages
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;

        // Only members of this room can create messages, and sender must match authenticated user
        allow create: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members &&
          request.resource.data.userId == request.auth.uid;

        // Only the message author or the room creator can update or delete messages
        allow update, delete: if request.auth != null && 
          (resource.data.userId == request.auth.uid || 
           get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }
    }

    // Tasks & Files collections
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    
    match /files/{fileId} {
      allow read, write: if request.auth != null;
    }
  }
}
